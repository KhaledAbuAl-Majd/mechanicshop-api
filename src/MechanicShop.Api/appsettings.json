{
  "EnableApiDocs": true,
  "EnableDataSeeding": true,
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=MechanicShopDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;",
    "Redis": "localhost:6379"
  },
  "AppSettings": {
    "OpeningTime": "00:00",
    "ClosingTime": "23:59:59",
    "MaxSpots": 4,
    "MinimumAppointmentDurationInMinutes": 30,
    "LocalCacheExpirationInMins": 5,
    "DistributedCacheExpirationMins": 5,
    "DefaultPageNumber": 1,
    "DefaultPageSize": 10,
    "BookingCancellationThresholdMinutes": 15,
    "OverdueBookingCleanupFrequencyMinutes": 3,
    "CorsPolicyName": "MechanicShop",
    "AllowedOrigins": []
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "MechanicShop.Api"
    }
  },
  "JwtSettings": {
    "Secret": "",
    "TokenExpirationInMinutes": 15,
    "RefreshTokenExpirationInDays": 7,
    "Issuer": "localhost",
    "Audience": "localhost"
  },
  "RateLimiterSettings": {
    "Global": {
      "PermitLimit": 60,
      "QueueLimit": 10,
      "WindowInMinutes": 1,
      "SegmentsPerWindow": 6
    },
    "Auth": {
      "PermitLimit": 5,
      "QueueLimit": 0,
      "WindowInMinutes": 1,
      "SegmentsPerWindow": 6
    },
    "HeavyExport": {
      "PermitLimit": 3,
      "QueueLimit": 0
    }
  }
}